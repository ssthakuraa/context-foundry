{
  "$id": "urn:context-foundry:schema:0.2.0:business-flow-step-payload",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "applicability": {
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "product_ids": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "anyOf": [
            {
              "const": "bounded",
              "type": "string"
            },
            {
              "const": "unknown",
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "capability_id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "flow_entity_id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "name": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "outcome_refs": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "precondition_refs": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "product_id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "flow_entity_id",
    "name",
    "product_id",
    "precondition_refs",
    "outcome_refs",
    "applicability"
  ],
  "type": "object"
}
