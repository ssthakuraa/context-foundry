{
  "$id": "urn:context-foundry:schema:0.2.0:implementation-proposal-body",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "affected_entity_ids": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "design_summary": {
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
    },
    "exclusions": {
      "items": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "findings_ref": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "body_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "version",
        "body_digest"
      ],
      "type": "object"
    },
    "ordered_steps": {
      "items": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "permitted_actions_requested": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "risks": {
      "items": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "rollback_approach": {
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
    },
    "source_fingerprints": {
      "items": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "validation_obligations": {
      "items": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "findings_ref",
    "design_summary",
    "affected_entity_ids",
    "ordered_steps",
    "permitted_actions_requested",
    "exclusions",
    "validation_obligations",
    "risks",
    "rollback_approach",
    "source_fingerprints"
  ],
  "type": "object"
}
