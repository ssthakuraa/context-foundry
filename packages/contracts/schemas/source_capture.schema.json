{
  "$id": "urn:context-foundry:schema:0.2.0:source-capture",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "authority_id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "capture_id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "capture_policy": {
      "anyOf": [
        {
          "const": "metadata_only",
          "type": "string"
        },
        {
          "const": "approved_content",
          "type": "string"
        }
      ]
    },
    "capture_producer_id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "captured_at": {
      "minLength": 1,
      "type": "string"
    },
    "classification": {
      "anyOf": [
        {
          "const": "public",
          "type": "string"
        },
        {
          "const": "internal",
          "type": "string"
        },
        {
          "const": "restricted",
          "type": "string"
        }
      ]
    },
    "file_manifest_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "publication_policy_ref": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "revision_kind": {
      "anyOf": [
        {
          "const": "git",
          "type": "string"
        },
        {
          "const": "enterprise_view",
          "type": "string"
        },
        {
          "const": "supplied_snapshot",
          "type": "string"
        }
      ]
    },
    "revision_value": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "0.2.0",
      "type": "string"
    },
    "snapshot_id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "source_id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "capture_id",
    "source_id",
    "authority_id",
    "snapshot_id",
    "revision_kind",
    "captured_at",
    "file_manifest_digest",
    "publication_policy_ref",
    "capture_producer_id",
    "capture_policy",
    "classification"
  ],
  "type": "object"
}
