{
  "$id": "urn:context-foundry:schema:0.2.0:coverage",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "adapter_id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "artifact_family": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "capture_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "diagnostic_refs": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "eligible_count": {
      "minimum": 0,
      "type": "integer"
    },
    "excluded_count": {
      "minimum": 0,
      "type": "integer"
    },
    "failed_count": {
      "minimum": 0,
      "type": "integer"
    },
    "known_unsupported": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "processed_count": {
      "minimum": 0,
      "type": "integer"
    },
    "reason": {
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "0.2.0",
      "type": "string"
    },
    "source_id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "const": "complete_for_declared_scope",
          "type": "string"
        },
        {
          "const": "partial",
          "type": "string"
        },
        {
          "const": "unsupported",
          "type": "string"
        },
        {
          "const": "unavailable",
          "type": "string"
        }
      ]
    },
    "supported_patterns": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "source_id",
    "capture_digest",
    "adapter_id",
    "artifact_family",
    "supported_patterns",
    "eligible_count",
    "processed_count",
    "failed_count",
    "excluded_count",
    "known_unsupported",
    "diagnostic_refs",
    "status"
  ],
  "type": "object"
}
