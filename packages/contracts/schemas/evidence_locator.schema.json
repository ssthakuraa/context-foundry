{
  "$id": "urn:context-foundry:schema:0.2.0:evidence-locator",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "additionalProperties": false,
      "properties": {
        "capture_id": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "end_line": {
          "minimum": 1,
          "type": "integer"
        },
        "kind": {
          "const": "file_range",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "capture_id",
        "path",
        "start_line",
        "end_line",
        "content_sha256"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "capture_id": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "kind": {
          "const": "document_section",
          "type": "string"
        },
        "section": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "capture_id",
        "section",
        "content_sha256"
      ],
      "type": "object"
    }
  ]
}
