{
  "$id": "urn:context-foundry:schema:0.2.0:findings-body",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "claims": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "claim_type": {
            "anyOf": [
              {
                "const": "source_observed",
                "type": "string"
              },
              {
                "const": "business_asserted",
                "type": "string"
              },
              {
                "const": "inference",
                "type": "string"
              },
              {
                "const": "hypothesis",
                "type": "string"
              }
            ]
          },
          "evidence_refs": {
            "items": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "read_receipt_refs": {
            "items": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "statement": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "statement",
          "claim_type",
          "evidence_refs",
          "read_receipt_refs"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "contradictions": {
      "items": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "impacts": {
      "items": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "source_fingerprints": {
      "items": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "unresolved_obligations": {
      "items": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "claims",
    "contradictions",
    "impacts",
    "unresolved_obligations",
    "source_fingerprints"
  ],
  "type": "object"
}
