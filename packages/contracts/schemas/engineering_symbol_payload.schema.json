{
  "$id": "urn:context-foundry:schema:0.2.0:engineering-symbol-payload",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {
      "anyOf": [
        {
          "const": "package",
          "type": "string"
        },
        {
          "const": "type",
          "type": "string"
        },
        {
          "const": "method",
          "type": "string"
        },
        {
          "const": "constructor",
          "type": "string"
        },
        {
          "const": "field",
          "type": "string"
        },
        {
          "const": "function",
          "type": "string"
        },
        {
          "const": "variable",
          "type": "string"
        },
        {
          "const": "module",
          "type": "string"
        }
      ]
    },
    "language": {
      "anyOf": [
        {
          "const": "java",
          "type": "string"
        },
        {
          "const": "typescript",
          "type": "string"
        }
      ]
    },
    "name": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "signature": {
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "name",
    "artifact_kind",
    "language"
  ],
  "type": "object"
}
