{
  "$id": "urn:context-foundry:schema:0.3.0:engineering-symbol-payload",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "language": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "name": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "qualified_name": {
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
    },
    "signature": {
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "name",
    "artifact_kind",
    "language"
  ],
  "type": "object"
}
