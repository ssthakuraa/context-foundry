{
  "name": "@context-foundry/contracts",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22"},
  "exports": {".": "./dist/index.js"},
  "types": "./dist/index.d.ts",
  "files": ["dist", "schemas"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/export-schemas.mjs",
    "schema:check": "node scripts/export-schemas.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "typescript": "5.9.3"
  }
}
